name: Build KAEL Music APK

on:
workflow_dispatch:
push:
paths:
- 'KAEL_Music_Fresh_Android_Project.zip'
- '.github/workflows/build.yml'

jobs:
build:
runs-on: ubuntu-latest
steps:
- name: Download repository
uses: actions/checkout@v4

  - name: Extract project ZIP
    run: |
      unzip -o KAEL_Music_Fresh_Android_Project.zip -d project

  - name: Set up Java
    uses: actions/setup-java@v4
    with:
      distribution: temurin
      java-version: '17'

  - name: Locate Gradle wrapper
    run: find project -name gradlew -type f

  - name: Build APK
    run: |
      cd project/kael-fresh
      chmod +x gradlew
      ./gradlew assembleDebug

  - name: Upload APK
    uses: actions/upload-artifact@v4
    with:
      name: KAEL-Music-APK
      path: project/kael-fresh/**/build/outputs/apk/debug/*.apk
