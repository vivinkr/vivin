name: Build KAEL Music APK

on:
workflow_dispatch:
push:
paths:
- 'KAEL_Music_Fresh_Android_Project.zip'
- '.github/workflows/build.yml'

jobs:
build:
runs-on: ubuntu-latest
steps:
- name: Download repository
uses: actions/checkout@v4

  - name: Extract project ZIP
    run: |
      unzip -o KAEL_Music_Fresh_Android_Project.zip -d project
      find project -maxdepth 4 -type f | head -100

  - name: Set up Java
    uses: actions/setup-java@v4
    with:
      distribution: temurin
      java-version: '17'

  - name: Build APK
    run: |
      cd project
      find . -name gradlew -type f
      chmod +x gradlew
      ./gradlew assembleDebug

  - name: Upload APK
    uses: actions/upload-artifact@v4
    with:
      name: KAEL-Music-APK
      path: project/**/build/outputs/apk/debug/*.apk
